# syntax=docker/dockerfile:1.7

# Agent Canvas v1.15.0, pinned to OpenHands commit ab23be62. The archive
# checksum makes the UI build fail closed if the upstream snapshot changes.
FROM node:26-slim AS evoloom-ui
WORKDIR /build
ADD https://codeload.github.com/OpenHands/OpenHands/tar.gz/ab23be62ad724fe83483036a0900bed7b7859166 \
  /tmp/agent-canvas.tar.gz
RUN echo "08100bfb8f8395b0a7e236634c06084cb5964cffa29ac7a7245cd2df47c7fa6b  /tmp/agent-canvas.tar.gz" \
      | sha256sum -c - \
    && tar -xzf /tmp/agent-canvas.tar.gz --strip-components=1 -C /build \
    && rm /tmp/agent-canvas.tar.gz
COPY ui/agent-canvas-overlay /tmp/evoloom-ui
COPY scripts/prepare-agent-canvas-classic-ui.mjs /tmp/prepare-agent-canvas-ui.mjs
RUN node /tmp/prepare-agent-canvas-ui.mjs /build /tmp/evoloom-ui \
    && npm ci
ARG VITE_BASE_PATH="/canvas"
ENV VITE_BASE_PATH=${VITE_BASE_PATH}
ENV VITE_DO_NOT_TRACK=1
RUN npm run build

FROM ghcr.io/openhands/agent-canvas:1.15.0

USER root
WORKDIR /opt/evoloom

COPY --from=evoloom-ui /build/build /opt/agent-canvas/frontend

COPY requirements.lock.txt pyproject.toml README.md LICENSE THIRD_PARTY_NOTICES.md ./
COPY LICENSES ./LICENSES
RUN python -m pip install --no-cache-dir -r requirements.lock.txt

COPY agents ./agents
RUN python -m pip install --no-cache-dir --no-deps . \
    && mkdir -p /workspace \
    && chown -R openhands:openhands /opt/evoloom /workspace

COPY scripts/cloudrun-entrypoint.sh /usr/local/bin/evoloom-cloudrun
COPY scripts/public-gateway.mjs /opt/evoloom/scripts/public-gateway.mjs
RUN chmod 755 /usr/local/bin/evoloom-cloudrun

USER openhands
WORKDIR /workspace
ENTRYPOINT ["tini", "--", "/usr/local/bin/evoloom-cloudrun"]
